# ==============================================================================
# Git Ignore Rules for PhoBERT-CRF (PAP_NER)
# ==============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Model Weights, Checkpoints & Outputs ---
outputs/
checkpoints/
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
statics/pretrained_model/

# --- Dataset Cache & Temporary Files ---
*.cached
Dataset/*.cached
*.tmp

# --- Training Logs & Monitoring ---
*.log
runs/
events.out.tfevents.*
.tensorboard/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*-checkpoint.ipynb
*copy*.ipynb

# --- External Toolkits & Models ---
vncorenlp/*.jar
tools/RDRsegmenter/
capu/

# --- IDE & Editor Settings ---
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# --- Operating System Artifacts ---
.DS_Store
Thumbs.db
desktop.ini
